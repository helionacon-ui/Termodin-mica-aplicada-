@formula Agua · gases · sistemas
$$x = \frac{v - v_f}{v_g - v_f}\qquad PV = mRT\qquad Q - W = \Delta U\qquad W = \frac{P_2V_2 - P_1V_1}{1-n}$$
$$\dot Q - \dot W = \dot m\left[\Delta h + \frac{\Delta c^2}{2} + g\Delta z\right]\qquad \eta_T = \frac{h_1 - h_2}{h_1 - h_{2s}}$$
@formula Segundo principio · entropía
$$\eta_{\text{Carnot}} = 1 - \frac{T_C}{T_H}\qquad \mathrm{COP}_{\text{ref}} = \frac{Q_C}{W}\qquad \Delta s = c_p\ln\frac{T_2}{T_1} - R\ln\frac{P_2}{P_1}\qquad S_{\text{gen}} \ge 0$$
@formula Ciclos
$$\eta_{\text{Brayton}} = 1 - r_p^{-(k-1)/k}\qquad \eta_{\text{Otto}} = 1 - r^{1-k}\qquad \mathrm{COP} = \frac{h_1 - h_4}{h_2 - h_1}$$
@formula Psicrometría · mezclas
